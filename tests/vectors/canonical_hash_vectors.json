{
  "spec_version": "xerbs-canonical-hash/1",
  "purpose": "Cross-repository canonical-hash vectors. xerbs-core consumes these verbatim when CORE-ATTEST integration lands: a digest recomputed by the same implementation inside an assertion proves nothing, so the expected values here are constants.",
  "rules": [
    "UTF-8; non-ASCII never escaped",
    "every string NFC-normalised before serialisation",
    "object keys sorted by Unicode code point",
    "separators (',', ':') -- no insignificant whitespace",
    "set-valued arrays sorted by canonical serialisation; ordered arrays keep order",
    "None omitted entirely, never serialised as null",
    "integers only; floats rejected",
    "excluded: primary keys, timestamps, environment-local ids, review_status, reviewer identity, version counter"
  ],
